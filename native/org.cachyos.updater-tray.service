[Unit]
Description=Cachy Updater systray applet
After=graphical-session.target

[Service]
# Prefer a fresh ~/.local install over the system package so rebuilds apply without sudo.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env cachyos-updater --tray
Restart=on-failure

[Install]
WantedBy=graphical-session.target
