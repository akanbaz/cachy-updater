[Desktop Entry]
Type=Application
Name=Cachy Updater
GenericName=System Updater
Comment=GUI system updater with news, cleanup, and tray support for CachyOS
Exec=cachy-updater %u
Icon=system-software-update
Terminal=false
Categories=System;Settings;PackageManager;
Keywords=update;pacman;cachy;packages;flatpak;aur;
StartupNotify=true
StartupWMClass=cachy-updater
X-GNOME-UsesNotifications=true
DBusActivatable=false
Actions=Tray;

[Desktop Action Tray]
Name=Start in tray
Exec=cachy-updater --tray
