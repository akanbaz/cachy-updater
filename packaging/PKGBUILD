# Maintainer: akanbaz
pkgname=cachyos-updater
pkgver=0.3.0
pkgrel=1
pkgdesc="Fast, native Kirigami system updater for CachyOS (updates, news, cleanup)"
arch=('x86_64')
url="https://github.com/akanbaz/cachy-updater"
license=('GPL-3.0-or-later')
depends=(
  'qt6-base'
  'qt6-declarative'
  'kirigami'
  'qqc2-desktop-style'
  'breeze-icons'
  'pacman'
  'polkit'
)
makedepends=(
  'cmake'
  'ninja'
  'qt6-base'
  'qt6-declarative'
)
optdepends=(
  'paru: AUR package updates'
  'pacman-contrib: repo update checks (checkupdates) and cache cleanup (paccache)'
  'expac: fast package metadata (sizes, groups, descriptions)'
  'flatpak: Flatpak application updates'
  'reflector: mirror ranking (future mirror-health card)'
)
conflicts=('cachy-updater')
replaces=('cachy-updater')
install=cachyos-updater.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/akanbaz/cachy-updater/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/cachy-updater-$pkgver/native"
  cmake -B build -S . \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$srcdir/cachy-updater-$pkgver/native"
  DESTDIR="$pkgdir" cmake --install build
}
